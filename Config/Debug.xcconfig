#include "Base.xcconfig"

// 개인 override가 있으면 이 뒤에서 덮어쓴다. 없으면 무시된다(`?`).
// 로컬 backend로 붙고 싶을 때만 Config/Local.xcconfig를 만든다.
#include? "Local.xcconfig"

APP_ENV = development

// **현재 정책: Debug도 production API를 쓴다.**
// 실기기 Debug 빌드로 실제 Apple 로그인을 디버깅하기 위해서다
// (localhost는 iPhone에서 iPhone 자신을 가리켜 서버에 닿지 못한다).
BACKEND_BASE_URL = $(URL_SCHEME)$(GGUMIRROR_API_HOST)
